rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isValidHistoryUpdate(userId) {
      return request.resource.data.userId == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "actionId",
          "actionName",
          "actionColor",
          "actionIcon",
          "titleSnapshot",
          "startedAt",
          "updatedAt"
        ]);
    }

    function isValidApiKeyCreate() {
      return request.resource.data.keys().hasOnly([
          "name",
          "prefix",
          "secretHash",
          "createdAt",
          "lastUsedAt",
          "revokedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.prefix == "et"
        && request.resource.data.secretHash is string
        && request.resource.data.secretHash.matches("^[a-f0-9]{64}$")
        && request.resource.data.createdAt is timestamp
        && request.resource.data.lastUsedAt == null
        && request.resource.data.revokedAt == null;
    }

    function isValidApiKeyRevoke() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["revokedAt"])
        && request.resource.data.revokedAt is timestamp;
    }

    match /users/{userId} {
      allow read, update, create: if isOwner(userId);
      allow delete: if false;

      match /actions/{actionId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /history_events/{eventId} {
        allow read, create: if isOwner(userId);
        allow update: if isOwner(userId) && isValidHistoryUpdate(userId);
        allow delete: if isOwner(userId);
      }

      match /api_keys/{keyId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidApiKeyCreate();
        allow update: if isOwner(userId) && isValidApiKeyRevoke();
        allow delete: if false;
      }
    }
  }
}
